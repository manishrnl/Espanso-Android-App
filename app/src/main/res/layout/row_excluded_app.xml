<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="78dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    tools:ignore="ContentDescription">

    <ImageView
        android:id="@+id/excludedAppIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="13dp"
        android:background="@drawable/bg_folder_icon"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shield"
        android:tint="@color/accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/excludedAppName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Google Pay" />

            <TextView
                android:id="@+id/excludedAppBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_accent_chip"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Banking" />
        </LinearLayout>

        <TextView
            android:id="@+id/excludedAppPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="11sp"
            tools:text="com.google.android.apps.nbu.paisa.user" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/excludedAppDeleteButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_button_secondary"
        android:padding="9dp"
        android:src="@drawable/ic_delete"
        android:tint="?attr/colorDanger"
        android:tooltipText="@string/delete" />

</LinearLayout>
